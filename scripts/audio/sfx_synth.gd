class_name SfxSynth
extends RefCounted
## Procedural sound synthesis. Every sound and music loop in NEON VANGUARD is
## generated by this code at startup, so the game ships with no third-party
## audio files and no licensing concerns.

const RATE := 22050


static func to_wav(samples: PackedFloat32Array, loop := false, rate := RATE) -> AudioStreamWAV:
	var bytes := PackedByteArray()
	bytes.resize(samples.size() * 2)
	for i in samples.size():
		bytes.encode_s16(i * 2, int(clampf(samples[i], -1.0, 1.0) * 32000.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.stereo = false
	wav.data = bytes
	if loop:
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = samples.size()
	return wav


static func _buf(seconds: float) -> PackedFloat32Array:
	var b := PackedFloat32Array()
	b.resize(int(seconds * RATE))
	return b


## Impact: pitched-down body thump + filtered noise crack.
static func impact(seconds: float, f0: float, f1: float, noise_amt: float, crack: float, rng: RandomNumberGenerator) -> PackedFloat32Array:
	var b := _buf(seconds)
	var n := b.size()
	var phase := 0.0
	var lp := 0.0
	for i in n:
		var t := float(i) / RATE
		var k := float(i) / n
		var f := lerpf(f0, f1, 1.0 - pow(1.0 - k, 3.0))
		phase += TAU * f / RATE
		var body := sin(phase) * exp(-t * 9.0)
		var nz := rng.randf_range(-1.0, 1.0)
		lp += (nz - lp) * 0.35
		var noise := lp * noise_amt * exp(-t * 22.0) + nz * crack * exp(-t * 60.0)
		var s := (body * 0.9 + noise) * 1.2
		b[i] = tanh(s * 1.6) * 0.8
	return b


static func whoosh(seconds: float, start_cut: float, end_cut: float, gain: float, rng: RandomNumberGenerator) -> PackedFloat32Array:
	var b := _buf(seconds)
	var n := b.size()
	var lp := 0.0
	var lp2 := 0.0
	for i in n:
		var k := float(i) / n
		var cut := lerpf(start_cut, end_cut, k)
		var nz := rng.randf_range(-1.0, 1.0)
		lp += (nz - lp) * cut
		lp2 += (lp - lp2) * cut
		var env := sin(PI * k) * sin(PI * k)
		b[i] = (lp - lp2) * env * gain
	return b


static func tone(seconds: float, freqs: Array, decay: float, gain: float, square := false) -> PackedFloat32Array:
	var b := _buf(seconds)
	for i in b.size():
		var t := float(i) / RATE
		var s := 0.0
		for f in freqs:
			var v := sin(TAU * f * t)
			if square:
				v = signf(v) * 0.6
			s += v
		var att := minf(1.0, t * 400.0)
		b[i] = s / freqs.size() * exp(-t * decay) * gain * att
	return b


static func sweep(seconds: float, f0: float, f1: float, gain: float, noise: float, rng: RandomNumberGenerator) -> PackedFloat32Array:
	var b := _buf(seconds)
	var n := b.size()
	var phase := 0.0
	for i in n:
		var k := float(i) / n
		phase += TAU * lerpf(f0, f1, k) / RATE
		var saw := fmod(phase / TAU, 1.0) * 2.0 - 1.0
		var env := minf(1.0, k * 20.0) * (1.0 - k)
		b[i] = (saw * 0.5 + sin(phase * 0.5) * 0.5 + rng.randf_range(-1, 1) * noise) * env * gain
	return b


static func mix(a: PackedFloat32Array, b: PackedFloat32Array, gb := 1.0) -> PackedFloat32Array:
	var out := a.duplicate()
	if b.size() > out.size():
		out.resize(b.size())
	for i in b.size():
		out[i] += b[i] * gb
	return out


## Builds the full library of short sound effects.
static func build_library() -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.seed = 7741
	var lib := {}
	lib["hit_light"] = to_wav(impact(0.14, 260.0, 120.0, 0.6, 0.5, rng))
	lib["hit_medium"] = to_wav(impact(0.22, 190.0, 70.0, 0.8, 0.6, rng))
	lib["hit_heavy"] = to_wav(impact(0.38, 140.0, 42.0, 1.0, 0.8, rng))
	lib["hit_special"] = to_wav(mix(impact(0.45, 150.0, 40.0, 1.0, 0.9, rng), tone(0.45, [880.0, 1320.0], 9.0, 0.25)))
	lib["proj_hit"] = to_wav(mix(impact(0.3, 300.0, 60.0, 0.7, 0.4, rng), sweep(0.3, 1200.0, 200.0, 0.3, 0.2, rng)))
	lib["block"] = to_wav(mix(tone(0.16, [1900.0, 2650.0], 30.0, 0.5), impact(0.1, 400.0, 250.0, 0.2, 0.9, rng), 0.6))
	lib["whiff_light"] = to_wav(whoosh(0.14, 0.25, 0.6, 0.9, rng))
	lib["whiff_heavy"] = to_wav(whoosh(0.28, 0.12, 0.45, 1.1, rng))
	lib["jump"] = to_wav(whoosh(0.16, 0.08, 0.3, 0.6, rng))
	lib["land"] = to_wav(impact(0.12, 120.0, 60.0, 0.4, 0.1, rng))
	lib["knockdown"] = to_wav(impact(0.4, 90.0, 35.0, 1.0, 0.3, rng))
	lib["projectile"] = to_wav(sweep(0.38, 220.0, 980.0, 0.55, 0.15, rng))
	lib["counter_ready"] = to_wav(tone(0.25, [660.0, 990.0], 10.0, 0.25))
	lib["counter"] = to_wav(mix(tone(0.8, [1046.0, 1568.0, 2093.0], 4.5, 0.45), impact(0.2, 300.0, 100.0, 0.3, 0.5, rng)))
	lib["throw"] = to_wav(mix(whoosh(0.2, 0.1, 0.4, 0.8, rng), impact(0.4, 110.0, 40.0, 0.9, 0.4, rng)))
	lib["tech"] = to_wav(mix(tone(0.2, [1400.0, 1760.0], 20.0, 0.45), impact(0.12, 500.0, 300.0, 0.2, 0.8, rng), 0.5))
	lib["ko"] = to_wav(mix(impact(1.3, 90.0, 28.0, 1.0, 0.8, rng), sweep(1.3, 600.0, 60.0, 0.25, 0.1, rng)))
	lib["ui_move"] = to_wav(tone(0.05, [1320.0], 60.0, 0.25, true))
	lib["ui_accept"] = to_wav(mix(tone(0.08, [880.0], 30.0, 0.3, true), _delay(tone(0.12, [1320.0], 25.0, 0.3, true), 0.06)))
	lib["ui_back"] = to_wav(mix(tone(0.08, [990.0], 30.0, 0.3, true), _delay(tone(0.12, [600.0], 25.0, 0.3, true), 0.06)))
	lib["round"] = to_wav(_chord_swell(1.1, [220.0, 277.18, 329.63, 440.0], 0.35))
	lib["fight"] = to_wav(mix(impact(0.6, 120.0, 40.0, 1.0, 1.0, rng), _chord_swell(0.6, [220.0, 329.63, 440.0, 659.25], 0.3)))
	lib["victory"] = to_wav(_arpeggio([523.25, 659.25, 783.99, 1046.5], 0.11, 0.35))
	return lib


static func _delay(samples: PackedFloat32Array, seconds: float) -> PackedFloat32Array:
	var pad := int(seconds * RATE)
	var out := PackedFloat32Array()
	out.resize(samples.size() + pad)
	for i in samples.size():
		out[i + pad] = samples[i]
	return out


static func _chord_swell(seconds: float, freqs: Array, gain: float) -> PackedFloat32Array:
	var b := _buf(seconds)
	var n := b.size()
	for i in n:
		var t := float(i) / RATE
		var k := float(i) / n
		var s := 0.0
		for f in freqs:
			s += sin(TAU * f * t) + 0.3 * sin(TAU * f * 2.003 * t)
		var env := minf(1.0, k * 6.0) * pow(1.0 - k, 1.5)
		b[i] = s / freqs.size() * env * gain
	return b


static func _arpeggio(freqs: Array, step: float, gain: float) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	for j in freqs.size():
		out = mix(out, _delay(tone(0.6, [freqs[j], freqs[j] * 2.0], 5.0, gain, true), step * j))
	return out


static func rain_loop(seconds: float) -> PackedFloat32Array:
	var rng := RandomNumberGenerator.new()
	rng.seed = 99
	var b := _buf(seconds)
	var n := b.size()
	var lp := 0.0
	var lp2 := 0.0
	var hum_phase := 0.0
	for i in n:
		var nz := rng.randf_range(-1.0, 1.0)
		lp += (nz - lp) * 0.5
		lp2 += (nz - lp2) * 0.04
		hum_phase += TAU * 55.0 / RATE
		var drop := 0.0
		if rng.randf() < 0.002:
			drop = rng.randf_range(0.3, 0.8)
		b[i] = lp * 0.22 + lp2 * 0.5 + sin(hum_phase) * 0.03 + drop * nz
	# Crossfade the ends so the loop is seamless.
	var fade := int(0.25 * RATE)
	for i in fade:
		var k := float(i) / fade
		b[i] = b[i] * k + b[n - fade + i] * (1.0 - k)
	b.resize(n - fade)
	return b


## Original synthwave music loop. `intensity` 0 = menu (no drums), 1 = battle.
static func music_loop(intensity: int) -> PackedFloat32Array:
	var bpm := 104.0 if intensity == 0 else 118.0
	var beat := 60.0 / bpm
	var bars := 8
	var total := bars * 4.0 * beat
	var b := _buf(total)
	var n := b.size()
	# i - VI - III - VII in A minor (Am, F, C, G), two bars each.
	var roots := [110.0, 87.31, 130.81, 98.0]
	var chords := [[220.0, 261.63, 329.63], [174.61, 220.0, 261.63], [261.63, 329.63, 392.0], [196.0, 246.94, 293.66]]
	var arp_notes := [0, 1, 2, 1, 2, 0, 2, 1]
	var rng := RandomNumberGenerator.new()
	rng.seed = 2049
	var pad_lp := 0.0
	var hat_hp := 0.0
	var prev_nz := 0.0
	var spb := beat * RATE
	for i in n:
		var t := float(i) / RATE
		var beat_pos := float(i) / spb
		var bar := int(beat_pos / 4.0) % bars
		var ci := (bar / 2) % 4
		var in_beat := fmod(beat_pos, 1.0)
		var eighth := fmod(beat_pos * 2.0, 1.0)
		var sixteenth := int(beat_pos * 4.0)
		var chord: Array = chords[ci]
		# Pad: detuned saws, low-passed.
		var pad := 0.0
		for f in chord:
			pad += fmod(t * f, 1.0) + fmod(t * f * 1.007, 1.0) - 1.0
		pad_lp += (pad / 3.0 - pad_lp) * 0.06
		var s := pad_lp * 0.22
		# Bass: eighth-note pulse on the root.
		var root: float = roots[ci]
		var bass_env := exp(-eighth * 3.5)
		var bass := (fmod(t * root, 1.0) * 2.0 - 1.0) * 0.6 + sin(TAU * root * t) * 0.6
		s += bass * bass_env * (0.18 if intensity == 0 else 0.26)
		# Arpeggio: sixteenth notes, an octave up.
		var note: float = chord[arp_notes[sixteenth % 8]] * 2.0
		var arp_env := exp(-fmod(beat_pos * 4.0, 1.0) * 6.0)
		s += signf(sin(TAU * note * t)) * arp_env * (0.05 if intensity == 0 else 0.06)
		if intensity > 0:
			# Kick on every beat.
			var kick_f := 50.0 + 90.0 * exp(-in_beat * 30.0)
			s += sin(TAU * kick_f * in_beat * beat) * exp(-in_beat * 9.0) * 0.55
			# Snare on 2 and 4.
			var beat_idx := int(beat_pos) % 4
			var nz := rng.randf_range(-1.0, 1.0)
			if beat_idx == 1 or beat_idx == 3:
				s += nz * exp(-in_beat * 14.0) * 0.28 + sin(TAU * 190.0 * t) * exp(-in_beat * 20.0) * 0.2
			# Closed hats on eighths.
			hat_hp = nz - prev_nz
			prev_nz = nz
			s += hat_hp * exp(-eighth * 40.0) * 0.06
		b[i] = tanh(s * 1.3) * 0.75
	return b
