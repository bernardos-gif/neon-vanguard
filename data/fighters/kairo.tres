[resource]
script = ExtResource("2_lav2x")
id = &"kairo"
display_name = "KAIRO"
title = "The Counter Specialist"
bio = "A disciplined martial artist from the Cobalt Ward training halls. Kairo studies every opponent like a puzzle and strikes the instant they make a mistake."
style_summary = "Balanced, precise and patient. Zone with Pulse Shot, punish with Comet Drive and read attacks with the Still Water counter."
